# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Optional custom Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=

# TWILIO SMS GATEWAY (Optional: For live SMS dispatch to drivers and dive centers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# GEMINI_MODEL: Model id used for all Gemini calls.
# Defaults to gemini-2.5-flash. (The previous hardcoded 'gemini-3.7-flash' is not
# a real model, so every AI call failed and silently returned a canned fallback.)
GEMINI_MODEL=gemini-2.5-flash

# PAYMOB EGYPT PAYMENT GATEWAY (Optional: For live merchant card & wallet settlement)
# PAYMOB_HMAC_SECRET is REQUIRED to accept webhooks. There is deliberately no
# fallback value: without it, every webhook is rejected rather than trusted.
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=

# SEED_USER_PASSWORD: Required to seed the demo Traveler/Supplier/Operations/Admin
# accounts on a boot with an empty user table. If unset, NO users are seeded.
# Never commit a real value here.
# Must be at least 16 characters, and must not be 'Dahab2026!Secure' — that
# value was committed to this repository and boot refuses it by name.
SEED_USER_PASSWORD=

# ENABLE_TEST_ENDPOINTS: Set to "true" to expose POST /api/testing/golden-journey.
# That endpoint writes real trips, bookings and ledger entries, so keep it off
# anywhere that holds data you care about.
ENABLE_TEST_ENDPOINTS=false

# DATABASE & PERSISTENCE CONFIGURATION (Optional: PostgreSQL / Cloud SQL Relational Storage)
# If DATABASE_URL is set or PERSISTENCE_ADAPTER=postgres, uses PostgresPersistenceAdapter.
# Otherwise falls back to durable atomic JSON disk persistence (JsonFilePersistenceAdapter).
DATABASE_URL=postgresql://postgres:password@localhost:5432/dahab_db
PERSISTENCE_ADAPTER=json
